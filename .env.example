# Copy this file to .env and fill in your values. Never commit .env.
ADMIN_TOKEN=change-this-to-a-long-random-string

# Email notifications (optional). For Gmail use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_TO=your-email@gmail.com

# Only if the website is hosted on a different domain than this backend:
# ALLOWED_ORIGIN=https://yourname.netlify.app
# Set to 1 when deployed behind a proxy (Render, Railway, Nginx):
# TRUST_PROXY=1

# Google Sheet (see google-apps-script.gs)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_SECRET=same-secret-as-in-the-apps-script
